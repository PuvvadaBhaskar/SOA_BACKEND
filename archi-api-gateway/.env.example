# archi-api-gateway - copy to .env and adjust. Spring does not read .env itself: export the variables (see README).
PORT=8080
# Must be identical in auth-service and archi-api-gateway (>= 32 characters)
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
JWT_ISSUER=archivalia-auth-service
# Must be identical in archi-api-gateway, book-service, borrow-service and fine-service
GATEWAY_SECRET=replace-with-another-long-random-string
EUREKA_URL=http://localhost:8761/eureka/
