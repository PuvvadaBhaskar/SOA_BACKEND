# fine-service - copy to .env and adjust. Spring does not read .env itself: export the variables (see README).
PORT=8084
DB_URL=jdbc:postgresql://localhost:5432/fine_db
DB_USERNAME=postgres
DB_PASSWORD=changeme
# Must be identical in archi-api-gateway, book-service, borrow-service and fine-service
GATEWAY_SECRET=replace-with-another-long-random-string
FINE_PER_DAY=10.0
EUREKA_URL=http://localhost:8761/eureka/
