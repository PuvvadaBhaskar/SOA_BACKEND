spring.application.name=auth-service

server.port=${PORT:8081}

spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/auth_db}
spring.datasource.username=${DB_USERNAME:postgres}
spring.datasource.password=${DB_PASSWORD:changeme}

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# ===============================
# JWT
# ===============================
# HMAC-SHA key (>= 32 bytes). MUST be identical in auth-service and archi-api-gateway.
jwt.secret=${JWT_SECRET:ArchivaliaDevOnlyJwtSecret-ChangeMe-0123456789abcdefABCDEF}
jwt.issuer=${JWT_ISSUER:archivalia-auth-service}
jwt.expiration-ms=${JWT_EXPIRATION_MS:3600000}

# ===============================
# Seeded administrator (created at startup if the username does not exist)
# ===============================
admin.username=${ADMIN_USERNAME:admin}
admin.password=${ADMIN_PASSWORD:Admin@12345}
admin.email=${ADMIN_EMAIL:admin@archivalia.local}

# ===============================
# Eureka
# ===============================
eureka.client.service-url.defaultZone=${EUREKA_URL:http://localhost:8761/eureka/}
eureka.client.healthcheck.enabled=true
eureka.instance.prefer-ip-address=true
eureka.instance.instance-id=${spring.application.name}:${random.value}
eureka.instance.lease-renewal-interval-in-seconds=5
eureka.instance.lease-expiration-duration-in-seconds=15

# ===============================
# Errors / Actuator
# ===============================
server.error.include-stacktrace=never
server.error.include-exception=false
management.endpoints.web.exposure.include=health,info
management.endpoint.health.show-details=always
management.info.env.enabled=true
info.app.name=Archivalia Auth Service
info.app.description=Registration, login and JWT issuing
