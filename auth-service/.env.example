# auth-service - copy to .env and adjust. Spring does not read .env itself: export the variables (see README).
PORT=8081
DB_URL=jdbc:postgresql://localhost:5432/auth_db
DB_USERNAME=postgres
DB_PASSWORD=changeme
# Must be identical in auth-service and archi-api-gateway (>= 32 characters)
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
JWT_ISSUER=archivalia-auth-service
JWT_EXPIRATION_MS=3600000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
ADMIN_EMAIL=admin@archivalia.local
EUREKA_URL=http://localhost:8761/eureka/
